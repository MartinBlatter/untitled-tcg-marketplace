# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values. Never commit .env.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- MySQL -----------------------------------------------------------------
# Read by src/db/mysql.ts, drizzle.config.ts and the bulk-import routes.
DB_HOST=localhost
DB_USER=your_mysql_user
DB_PASS=your_mysql_password
DB_SCHEMA=tcg

# --- Sessions --------------------------------------------------------------
# Signs the session cookie. Read by src/lib/auth/session.ts.
# Generate with:  openssl rand -base64 32
# Changing this invalidates every existing session, logging everybody out.
SESSION_SECRET=generate_a_random_32_byte_base64_string

# --- Card images -----------------------------------------------------------
# Public base URL that card images are served from. Exposed to the browser.
# For local development you can point this at the app itself.
NEXT_PUBLIC_IMAGE_HOST=http://localhost:3000

# --- Scheduled jobs --------------------------------------------------------
# Shared secret for the /api/cron/* endpoints, which mutate orders and move
# funds. Every request must send:  Authorization: Bearer $CRON_SECRET
# On Vercel, set this as a project environment variable and Vercel Cron sends
# the header itself. If it is unset the cron endpoints return 503 and do
# nothing. Generate one with:  openssl rand -base64 32
CRON_SECRET=generate_a_random_32_byte_base64_string

# --- Optional --------------------------------------------------------------
# Declared historically but not read anywhere in the current codebase.
NEXT_PUBLIC_SYSTEM_ENV=development

# Set to true to log every Drizzle query, bound parameters included, to the
# console. Off by default.
# DB_LOG_QUERIES=false
