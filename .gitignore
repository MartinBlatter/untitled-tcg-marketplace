# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.session.sql

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files - never commit real credentials; .env.example is the template
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# card images
/public/images/magic/cards

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# temp data
importdata/*
image-errors.json
images.csv

# editor-local config that may contain credentials
.vscode/mcp.json

# user-uploaded runtime content (avatars, banners, card photos)
/public/uploads/**
!/public/uploads/**/
!/public/uploads/**/.gitkeep

# temp image working dir
/temp-images/
